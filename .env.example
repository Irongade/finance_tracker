# Postgres. DATABASE_URL is what the app uses: Postgres.app locally, the Neon *pooled* URL on Vercel.
DATABASE_URL=postgresql://localhost:5432/finance_tracker
DATABASE_URL_TEST=postgresql://localhost:5432/finance_tracker_test
# Neon, for one-off CLI work from your machine: DB_TARGET=prod (pnpm db:migrate:prod / db:seed:prod).
# DATABASE_URL_PROD=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/finance_tracker?sslmode=require

# Email (password resets, invite emails). Optional: without a key, links are
# printed to the server log locally and shown in the UI to copy.
# RESEND_API_KEY=re_xxx
# EMAIL_FROM=Ade & P <you@yourdomain>

# Better Auth. Generate the secret with: openssl rand -base64 32. Use a different one in production.
BETTER_AUTH_SECRET=change-me-32-bytes-min
BETTER_AUTH_URL=http://localhost:3000   # on Vercel: optional; derived per request (*.vercel.app). Set it once you attach a custom domain.

# Dev seed accounts (pnpm db:seed). Both users, same household.
SEED_USER1_EMAIL=ade@example.com
SEED_USER1_PASSWORD=password123
SEED_USER2_EMAIL=p@example.com
SEED_USER2_PASSWORD=password123
